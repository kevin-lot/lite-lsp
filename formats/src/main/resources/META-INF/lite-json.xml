<!-- `$ref` in JSON files (OpenAPI, AsyncAPI, JSON Schema), JSON targets of YAML `$ref`, `package.json` scripts: needs the JSON plugin. -->
<idea-plugin>
    <extensions defaultExtensionNs="com.intellij">
        <annotator language="JSON" implementationClass="me.kevinlot.lite.formats.config.PackageScriptNamesAnnotator"/>
        <multiHostInjector implementation="me.kevinlot.lite.formats.config.PackageScriptInjector"/>
        <psi.referenceContributor language="JSON" implementation="me.kevinlot.lite.formats.config.JsonRefContributor"/>
        <psi.referenceContributor language="JSON" implementation="me.kevinlot.lite.formats.config.PackageScriptContributor"/>
    </extensions>
    <extensions defaultExtensionNs="me.kevinlot.lite">
        <pointerTargets implementation="me.kevinlot.lite.formats.config.JsonPointerTargets"/>
    </extensions>
</idea-plugin>
